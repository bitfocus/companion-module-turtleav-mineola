{
	"name": "turtleav-mineola",
	"version": "2.0.0",
	"main": "dist/main.js",
	"type": "module",
	"scripts": {
		"postinstall": "husky",
		"format": "prettier -w .",
		"package": "run build && companion-module-build",
		"build": "rimraf dist && run build:main",
		"build:main": "tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json --watch",
		"lint:raw": "eslint",
		"lint": "run lint:raw .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bitfocus/companion-module-turtleav-mineola.git"
	},
	"engines": {
		"node": "^26.5",
		"yarn": "^4"
	},
	"dependencies": {
		"@companion-module/base": "~2.2.2",
		"axios": "^1.21.1",
		"es-toolkit": "^1.53.2",
		"p-queue": "^10.0.0",
		"ws": "^8.23.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.2.1",
		"@types/node": "^26.6.6",
		"@types/ws": "^8.18.2",
		"@vitest/coverage-v8": "5.1.0",
		"eslint": "^10.15.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"prettier": "^3.10.1",
		"rimraf": "^6.1.4",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8",
		"vitest": "5.1.0"
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"lint-staged": {
		"*.{css,json,md,scss}": [
			"prettier --write"
		],
		"*.{ts,tsx,js,jsx}": [
			"yarn lint:raw --fix"
		]
	},
	"packageManager": "yarn@4.18.1"
}
